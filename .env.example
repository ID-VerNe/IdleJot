API_BASE=https://api.deepseek.com
API_KEY=
MODEL=deepseek-flash

# balanced: retain one verified QQ plaintext cache for incremental page reuse;
# space: remove it after successful imports (slower next refresh).
# Both preserve imported history, media and source identity checks.
QQ_CACHE_MODE=balanced

# Configured Agent budget (legacy UI/API). The main UI slider overrides these
# AGENT_* fields with its selected preset; endpoint/key/model are unchanged.
# Reloaded for each new turn; higher ceilings allow more work,
# they do not force the model to exhaust the budget. DeepSeek effort: none/low/high/max.
AGENT_REASONING_EFFORT=high
AGENT_MAX_REQUESTS=12
AGENT_MAX_TOOL_CALLS=30
AGENT_MAX_MESSAGES=300
AGENT_MAX_EVIDENCE_CHARS=72000
AGENT_MAX_REQUEST_CHARS=200000
AGENT_MAX_SECONDS=600
# Includes reasoning and final output tokens on the official DeepSeek endpoint.
AGENT_MAX_OUTPUT_TOKENS=16384
AGENT_STREAM_IDLE_SECONDS=90

# Optional QQ group directory API. Localhost only; leave blank for local file messages.
ARTIFACT_ONEBOT_URL=
ARTIFACT_ONEBOT_TOKEN=
# Optional OneBot HTTP event HMAC secret, independent from the API token.
ARTIFACT_ONEBOT_EVENT_SECRET=

# Optional native voice: local only. No cloud ASR and no bulk transcription by default.
# Run the project Python with scripts/setup_voice.py for the pinned runtime/model.
# Linux: .venv/bin/python
# Strategy (lazy/new/manual-backfill) is saved in SQLite from the data import UI.
# Blank selects the platform default. Set a path only for a custom runtime.
VOICE_EXECUTABLE=
VOICE_MODEL_PATH=.cache/voice-models/ggml-small-q5_1.bin
# Chinese first (also permits English terms); auto/en available for non-Chinese audio.
VOICE_LANGUAGE=zh
VOICE_THREADS=4
VOICE_TIMEOUT_SECONDS=180
VOICE_MAX_SECONDS=180
VOICE_MAX_BYTES=16777216
# Optional approved QQ sending (independent of read-only ARTIFACT_ONEBOT_*).
# A local SnowLuma / NapCat OneBot v11 HTTP service must already be running.
# Empty URL disables sending; draft generation and copying remain available.
REPLY_ONEBOT_URL=
REPLY_ONEBOT_TOKEN=
# OneBot forward WebSocket event server, used only by MCP continuous group chat.
# HTTP and WebSocket tokens may differ; blank WS token falls back to HTTP token.
REPLY_ONEBOT_WS_URL=
REPLY_ONEBOT_WS_TOKEN=
